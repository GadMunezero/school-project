# Ready-made configuration for trying Tradeloom on your own machine.
#
#   docker compose --env-file .env.demo up -d --build
#
# It exists so that evaluating the app takes one command on any operating system, with no shell
# script and nothing to fill in. Committing it is safe for exactly one reason: every value here is
# a development value, and Settings.validate_for_production() refuses to start a production
# process with any of them. It is not a template for deployment — see .env.example for that, and
# docs/RUNBOOK.md for doing it properly.
#
# The key below is public, in version control, and known to anyone who has read this repository.
# It signs session cookies. Never put it on a machine anyone else can reach.

TRADELOOM_ENV=development
SECRET_KEY=demo-only-key-published-in-git-not-secret-do-not-deploy-0123456789
COOKIE_SECURE=false
DEBUG=false

# Everything is served from one origin by the nginx proxy on :8080 — the app, the API and the
# docs. The browser therefore makes same-origin requests and no CORS configuration applies.
# The frontend bakes this in at build time, so changing the port means rebuilding.
APP_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Open signup, because this is for looking around. A real beta wants SIGNUP_MODE=invite.
SIGNUP_MODE=open

STRIPE_ENABLED=false

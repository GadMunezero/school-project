# ---------------------------------------------------------------------------
# Tradeloom environment configuration
# Copy to .env and replace every CHANGE_ME value. Never commit a real .env.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
TRADELOOM_ENV=development                 # development | test | staging | production
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                           # json | console
DEBUG=false

# --- URLs ------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
COOKIE_DOMAIN=                            # leave blank for host-only cookies
COOKIE_SECURE=false                       # MUST be true in production (HTTPS only)
SESSION_COOKIE_NAME=tl_session
CSRF_COOKIE_NAME=tl_csrf

# --- Database --------------------------------------------------------------
POSTGRES_USER=tradeloom
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=tradeloom
DATABASE_URL=postgresql+asyncpg://tradeloom:CHANGE_ME_postgres_password@postgres:5432/tradeloom
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1680

# --- Sessions & crypto -----------------------------------------------------
# 64+ random characters. Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_secret_key_at_least_64_characters_long_random_value_here
SESSION_TTL_SECONDS=1209600               # 14 days absolute lifetime
SESSION_IDLE_TIMEOUT_SECONDS=86400        # 24 hours of inactivity
SESSION_ROTATE_AFTER_SECONDS=3600         # rotate the session id hourly
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_VERIFY_TTL_SECONDS=86400
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2

# --- Error reporting (optional) --------------------------------------------
# Leave blank and nothing is sent anywhere. With a DSN set, the API and worker report
# unhandled errors. Request bodies, cookies and headers are never attached, secrets are
# scrubbed against the same list the logs use, and a user is identified by id only.
# Requires the extra:  pip install -e "backend[monitoring]"
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Signup ----------------------------------------------------------------
# invite = only someone holding a code an administrator issued can register.
# open   = anyone can. Closed is the right setting for a beta; open it when you mean to.
# Issue codes under Administration -> Invites, or with `tradeloom.cli invite --note "..."`.
SIGNUP_MODE=invite

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIGNUP=5/hour
LOGIN_LOCKOUT_THRESHOLD=8                 # failed attempts before temporary lockout
LOGIN_LOCKOUT_SECONDS=900

# --- SMTP (email verification, password reset, notifications) --------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_FROM_EMAIL=no-reply@tradeloom.local
SMTP_FROM_NAME=Tradeloom
EMAIL_ENABLED=true                        # false writes rendered emails to the log instead

# --- OAuth (optional; leave blank to hide the buttons) ---------------------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1/auth/oauth

# --- Object storage (S3 compatible: AWS S3, MinIO, R2, Spaces) ------------
S3_ENDPOINT_URL=http://minio:9000         # blank for real AWS S3
S3_REGION=us-east-1
S3_BUCKET=tradeloom-uploads
S3_ACCESS_KEY_ID=CHANGE_ME_minio_access_key
S3_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_key
S3_FORCE_PATH_STYLE=true                  # true for MinIO, false for AWS S3
S3_PUBLIC_BASE_URL=http://localhost:9000  # used to rewrite signed URLs for browsers
S3_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=10485760                 # 10 MiB per file
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp,image/gif,text/csv,application/json

# --- Stripe billing --------------------------------------------------------
STRIPE_ENABLED=false                      # false = billing UI runs in local entitlement mode
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PRICE_PRO_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_PRO_YEARLY=price_CHANGE_ME
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_CHANGE_ME
BILLING_SUCCESS_URL=http://localhost:3000/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled

# --- Market data providers -------------------------------------------------
MARKET_DATA_DEFAULT_SOURCE=seed           # identifier of the registered provider to use
# No third-party market data provider is configured by default. Tradeloom never
# labels data as real-time unless a live provider is registered and connected.

# --- Frontend (Next.js reads these at build/runtime) -----------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Tradeloom
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
INTERNAL_API_BASE_URL=http://api:8000     # server-side calls inside the compose network

# --- Demo seed -------------------------------------------------------------
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=DemoTrader!2024
SEED_RANDOM_SEED=20240517                 # deterministic demo data
